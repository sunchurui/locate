 # NOTE(sgm): this implementation only consider outcome supervision, where the reward is a scalar.
+@torch.no_grad()
+def compute_groundingpi_advantage(reward_components, response_mask, index, eps=1e-8):
+    """Normalize each reward per prompt, combine 0.7/0.3, then normalize the batch."""
+    if reward_components.ndim != 2 or reward_components.shape[1] != 2:
+        raise ValueError('GroundingPI requires two reward components per response')
+    if len(index) != reward_components.shape[0] or response_mask.shape[0] != len(index):
+        raise ValueError('GroundingPI reward, response mask and prompt ID counts differ')
+    if not torch.isfinite(reward_components).all():
+        raise ValueError('GroundingPI reward components must be finite')
+    groups = defaultdict(list)
+    for i, uid in enumerate(index):
+        groups[uid].append(i)
+    weighted = torch.zeros(reward_components.shape[0], device=reward_components.device,
+                           dtype=reward_components.dtype)
+    weights = reward_components.new_tensor([0.7, 0.3])
+    for indices in groups.values():
+        if len(indices) < 2:
+            raise ValueError('GroundingPI GRPO requires at least two responses per prompt')
+        sample = reward_components[indices]
+        normalized = (sample - sample.mean(dim=0)) / (sample.std(dim=0, unbiased=True) + eps)
+        weighted[indices] = (normalized * weights).sum(dim=1)
+    if weighted.numel() < 2:
+        raise ValueError('GroundingPI batch must contain at least two responses')
+    advantage = (weighted - weighted.mean()) / (weighted.std(unbiased=True) + eps)
+    returns = advantage.unsqueeze(-1) * response_mask
+    return returns, returns
+
+
